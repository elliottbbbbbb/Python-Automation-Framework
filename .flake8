[flake8]
max-line-length = 88
extend-ignore = E203, W503, E501
exclude =
    .venv,
    env,
    __pycache__,
    .git,
    __pycache__,
    .pytest_cache,
    *.egg-info

# E203: whitespace before ':' (conflicts with black)
# W503: line break before binary operator (conflicts with black)
# E501: line too long (black handles this, some docstrings/comments may exceed)
