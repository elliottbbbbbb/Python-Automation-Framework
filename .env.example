# License Server Configuration
LICENSE_API_URL=http://localhost:8000

# Mouse Service Configuration
# Options: none (default), win32, interception
USE_WIN32=false
USE_INTERCEPTION=false

# Arduino Configuration (if using hardware mouse)
ARDUINO_ENABLED=false
ARDUINO_PORT=COM3

# RuneLite Status Socket Plugin
RUNELITE_DATA_FILE=C:\Users\YOUR_USERNAME\.runelite\live_data.json
