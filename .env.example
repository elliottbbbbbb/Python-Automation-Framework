# OSRS Bot Environment Configuration
# Copy this file to .env and configure your settings

# Mouse Input Driver (OPTIONAL - Advanced Feature)
# Set to 1 to use Interception driver (kernel-level input)
# Set to 0 or comment out to use standard mouse control (default, recommended)
# Note: Interception requires complex driver setup - see INTERCEPTION_SETUP.md
# Most users should leave this at 0
USE_INTERCEPTION=0

# Tesseract OCR Path (optional)
# Uncomment and set if tesseract is not in your system PATH
# Windows example: TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: TESSERACT_PATH=/usr/bin/tesseract
# TESSERACT_PATH=

# Logging Level (optional)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Development Mode (optional)
# Set to 1 to enable additional debug features
# DEV_MODE=0
